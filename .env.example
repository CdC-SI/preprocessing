# Modèles à utiliser pour la pipeline pdf extraction (stage 1 à stage 4):
VLM_URL="" # url du modèle d'inférence de VLM à utiliser, voir avec l'équipe infra
VLM_MODEL_NAME="" # nom du modèle d'inférence de VLM à utiliser, voir avec l'équipe infra

# Certificat de l'autorité de certification de VLM pour le wsl Ubuntu :
VLM_CA_PEM="" # chemin vers le certificat de l'autorité de certification de VLM (fourni par l'équipe infra)

# Pour pipeline OCR, pdf à tester & description des images
DOC_NAME="" # CHANGER SELON LES TESTS ne pas mettre .pdf
DOC_PATH="" # Chemin relatif dans input_files/ si le PDF est dans un sous-dossier (ex: "Adhésion/Adhésion traitement.pdf"). Laisser vide pour utiliser input_files/<DOC_NAME>.pdf
ENABLE_IMAGE_EXTRACTION=true # Activer ou désactiver l'extraction des images via Docling (true/false), utilisé par pipeline_multietape_modular.py
ENABLE_IMAGE_DESCRIPTION=true # Activer ou désactiver la description des images (true/false) — surchargé par --image-description/--no-image-description en CLI si passé explicitement
GEN_ID="5"
VLM_TEMPERATURE="" # Température pour les générations VLM (ajuster selon les besoins, ex. 0.6)

# Modèles à utiliser pour la pipeline retrieval :
LLM_URL=""
LLM_MODEL_NAME=""

# Modèles à utiliser pour la pipeline embedding :
EMBEDDING_URL=""
EMBEDDING_MODEL_NAME=""

# Modèles à utiliser pour la pipeline reranking :
RERANKER_URL=""
RERANKER_MODEL_NAME=""

# Modèles à utiliser pour la pipeline tokenization :
TOKENIZER_URL=""
TOKENIZER_MODEL_NAME=""

# Nombre maximum de tokens pour les embeddings (à définir en fonction du modèle d'embedding utilisé) :
MAX_EMBEDDING_TOKENS=""

# NEO4J
NEO4J_URI=""
NEO4J_USER=""
NEO4J_PASSWORD=""

VISUALISER_LE_GRAPH=""