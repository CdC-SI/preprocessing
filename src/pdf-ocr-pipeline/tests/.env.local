# Local development / testing configuration.
# Points every upstream at the mock model server (tests/mock_models.py).
VLM_URL=http://127.0.0.1:9100/v1
VLM_MODEL_NAME=mock-vlm
LLM_URL=http://127.0.0.1:9100/v1
LLM_MODEL_NAME=mock-llm
EMBEDDING_URL=http://127.0.0.1:9100/v1
EMBEDDING_MODEL_NAME=mock-embedding
AUTH_TOKEN=
VERIFY_SSL=false

# Small values so tests exercise chunk boundaries and the queue quickly.
CHUNK_TOKEN_BUDGET=5000
MAX_EMBEDDING_TOKENS=32768
SUMMARY_HEADROOM_TOKENS=1024

LARGE_DOC_PAGE_THRESHOLD=5
VLM_MAX_CONCURRENCY=4
OCR_LARGE_DOC_CONCURRENCY=2
WORKER_COUNT=6

PDF_RENDER_DPI=110
JPEG_QUALITY=85

LEGACY_MAX_PAGES=10
MAX_UPLOAD_BYTES=10485760
MAX_PAGES=1000

RESULT_TTL_SECONDS=3600
METADATA_TTL_SECONDS=86400
AGING_PROMOTION_SECONDS=60

LOG_LEVEL=INFO
