# --- Model endpoints -------------------------------------------------------
VLM_URL=https://your-vlm-endpoint.example.com/v1
VLM_MODEL_NAME=your-vlm-model-name
LLM_URL=https://your-llm-endpoint.example.com/v1
LLM_MODEL_NAME=your-llm-model-name
EMBEDDING_URL=https://your-embedding-endpoint.example.com/v1
EMBEDDING_MODEL_NAME=embedding-inference

# Decoded SA token:
#   oc get secret model-serving-sa-token -n model-serving \
#     -o jsonpath='{.data.token}' | base64 -d
AUTH_TOKEN=eyJhbGciOiJSUzI1NiIs...

# NOTE: TOKENIZER_URL / TOKENIZER_MODEL_NAME are no longer used.
# Tokenization is local; see tokenizer/ and TOKENIZER_DIR.

# --- Chunking --------------------------------------------------------------
# Working chunk size. Main retrieval-quality lever; tune during eval.
CHUNK_TOKEN_BUDGET=5000
# Hard limit of Qwen3-Embedding-0.6B.
MAX_EMBEDDING_TOKENS=32768
# Reserved for summaries prefixed to the chunk before embedding.
SUMMARY_HEADROOM_TOKENS=1024
EMBEDDING_BATCH_SIZE=8

# --- Concurrency -----------------------------------------------------------
# The VLM runs with --max-num-seqs=17 shared with translation. This cap
# reserves at least 13 slots for translation at all times.
VLM_MAX_CONCURRENCY=4
OCR_LARGE_DOC_CONCURRENCY=2
WORKER_COUNT=6
LARGE_DOC_PAGE_THRESHOLD=5
AGING_PROMOTION_SECONDS=900
PAGE_MAX_ATTEMPTS=3

# --- Rendering -------------------------------------------------------------
# DPI drives image token cost more than anything else. Benchmark before changing.
PDF_RENDER_DPI=150
JPEG_QUALITY=85
MAX_IMAGE_EDGE_PX=2000

# --- Limits and retention --------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_PAGES=1000
LEGACY_MAX_PAGES=10
RESULT_TTL_SECONDS=3600
METADATA_TTL_SECONDS=86400
MAX_RESULT_BYTES=2147483648

# --- Feature flags (Phase 4) ----------------------------------------------
TEXT_LAYER_EXTRACTION_ENABLED=false
CONTEXTUAL_RETRIEVAL_ENABLED=false

LOG_LEVEL=INFO
