# Virtual environment and secrets production
.env

# Virtual environment and secrets test/dev
.env.test

# Virtual environnemt for preprocessing pipeline/baseline pipeline
.venv

# Python cache files remove
*.pyc

# Removing all sources of data files, except for the 5 input/output/evaluation
# directories and their .gitkeep files — les scripts créent ces dossiers à la
# volée, les .gitkeep servent à montrer la structure attendue à qui clone.
# ⚠ data/ vit à la racine du dépôt, HORS de src/ (lot 1 du refactor)
# ⚠ Les DEUX lignes sont nécessaires par dossier : la première ré-inclut le
#   dossier (sinon git n'y entre pas), la seconde le fichier.
data/**

!data/input_files/
!data/input_files/.gitkeep

!data/output_files_baseline/
!data/output_files_baseline/.gitkeep

!data/output_files_preprocessing/
!data/output_files_preprocessing/.gitkeep

!data/pipeline_evaluation/
!data/pipeline_evaluation/.gitkeep

# Rapport de comparaison final (comparison_report.md + charts/)
!data/baseline_evaluation/
!data/baseline_evaluation/.gitkeep

# Not showing those repo repo (local test)
src/afac_preprocessing/graph_url/
graphify-out

# KG export, control not sensitive data published
src/afac_preprocessing/neo4j_graphrag_ontology/examples
src/afac_preprocessing/neo4j_graphrag_ontology/export/
src/afac_preprocessing/pipeline_preprocessing/docling_image_png
src/afac_preprocessing/neo4j_graphrag_ontology/extraction_concepts/output
src/afac_preprocessing/neo4j_graphrag_ontology/extraction_concepts/qa_runs

# Others
src/afac_preprocessing/neo4j_graphrag_ontology/PLAN_retrieval_scoring_reranking.md
NOTES_NOTEBOOKS_JUPYTER.md
PLAN_REFACTOR_OOP.md
tests/reference/
tests/reference_F*/
ETAT_REFACTOR.md
csv_panda
other_test
